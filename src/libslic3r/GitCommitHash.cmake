find_package(Git QUIET)
set(FULL_HASH "")
set(SUFFIX "")
if(DEFINED ENV{git_commit_hash} AND NOT "$ENV{git_commit_hash}" STREQUAL "")
    set(_build_ref "$ENV{git_commit_hash}")
elseif(EXISTS "${SOURCE_DIR}/scripts/engine-source.json")
    file(READ "${SOURCE_DIR}/scripts/engine-source.json" _engine_source)
    string(JSON _build_ref GET "${_engine_source}" engine_source_sha)
else()
    set(_build_ref HEAD)
endif()
string(LENGTH "${_build_ref}" _ref_length)
if(_ref_length EQUAL 40 AND _build_ref MATCHES "^[0-9a-fA-F]+$")
    string(TOLOWER "${_build_ref}" FULL_HASH)
elseif(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --verify "${_build_ref}^{commit}"
        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE FULL_HASH OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _resolved ERROR_QUIET)
    if(NOT _resolved EQUAL 0)
        message(FATAL_ERROR "Cannot resolve the engine source identity: ${_build_ref}")
    endif()
endif()
string(LENGTH "${FULL_HASH}" _full_length)
if(NOT _full_length EQUAL 40 OR NOT FULL_HASH MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "A full engine source SHA is required in scripts/engine-source.json or git_commit_hash")
endif()
string(SUBSTRING "${FULL_HASH}" 0 10 HASH)
if(NOT DEFINED ENV{git_commit_hash} AND GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND ${GIT_EXECUTABLE} diff --quiet HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE _dirty ERROR_QUIET)
    if(_dirty EQUAL 1)
        set(SUFFIX "-dirty")
    endif()
endif()
message(STATUS "Build commit: ${HASH}${SUFFIX}")
string(CONCAT CONTENT "#pragma once\n"
    "#define GIT_COMMIT_HASH \"${HASH}\"\n"
    "#define GIT_COMMIT_FULL_HASH \"${FULL_HASH}\"\n"
    "#define GIT_COMMIT_SUFFIX \"${SUFFIX}\"\n")
set(OLD "")
if(EXISTS "${OUT_FILE}")
    file(READ "${OUT_FILE}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
    file(WRITE "${OUT_FILE}" "${CONTENT}")
endif()
